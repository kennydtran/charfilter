{
  "manifest_version": 3,
  "name": "VTT Caption Detector for Text Filter",
  "version": "1.0",
  "description": "Automatically detect VTT caption files from any webpage and send to Text Filter app",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VTT Caption Detector"
  }
}
